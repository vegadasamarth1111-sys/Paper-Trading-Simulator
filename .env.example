# =============================================================================
# Paper Trading Simulator — Environment Variables Template
# COPY this file to .env and fill in real values. NEVER commit .env itself.
# =============================================================================

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key-print(get_random_secret_key())
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
DB_NAME=paper_trading
DB_USER=paper_trader
DB_PASSWORD=CHANGE-ME-strong-random-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL_CA=
DB_CONN_MAX_AGE=600

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_CELERY_URL=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_SIGNING_KEY=CHANGE-ME-separate-from-django-secret

# ---------------------------------------------------------------------------
# Broker API (Market Data Provider)
# ---------------------------------------------------------------------------
BROKER_API_KEY=CHANGE-ME
BROKER_API_SECRET=CHANGE-ME
BROKER_API_REDIRECT_URL=http://localhost:8000/api/v1/broker/callback
BROKER_PROVIDER=zerodha

# ---------------------------------------------------------------------------
# Market Data — Phase 1 (FREE tier: works with everything below as default)
# ---------------------------------------------------------------------------
# yahoo = keyless history + polling (default, zero keys needed).
# angel = keyless public master; quotes need the four ANGEL_* keys.
MARKET_DATA_PROVIDER=yahoo
POLL_INTERVAL_SECONDS=60
STALE_TICK_SECONDS=900
DATA_GAP_SECONDS=300
BAD_TICK_RATIO_ALERT=0.05
YAHOO_TIMEOUT_SECONDS=15.0
# Angel One — leave empty until you want real-time quotes. The app explains
# exactly what is missing instead of failing silently.
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Paper Broker — Phase 2 fill realism (all safe defaults; uncomment to tune)
# ---------------------------------------------------------------------------
#PAPER_SLIPPAGE_BPS=2
#PAPER_SLIPPAGE_TICKS=0
#PAPER_LATENCY_MS=300
#PAPER_FILL_MAX_DEPTH_RATIO=0.5
#PAPER_CONSERVATIVE_LIMIT=True
#PAPER_MIN_DEPTH_QTY=0
#PAPER_MIN_VOLUME=0

# ---------------------------------------------------------------------------
# ML Scoring — Phase 6 (publisher artifact drop directory)
# ---------------------------------------------------------------------------
#ML_SCORE_DIR=ml_scores

# ---------------------------------------------------------------------------
# Backups — Phase 7 (Fernet key; backup_db refuses to run without it)
# ---------------------------------------------------------------------------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#BACKUP_ENCRYPTION_KEY=
#BACKUP_DIR=backups

# ---------------------------------------------------------------------------
# Telegram Alerts
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=CHANGE-ME
TELEGRAM_CHAT_ID=CHANGE-ME

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_DEFAULT=100/hour
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_ORDERS=30/minute

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
ADMIN_IP_WHITELIST=127.0.0.1,::1

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://127.0.0.1:6379/2

# ---------------------------------------------------------------------------
# Sentry (Error Tracking)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Environment Guard (CRITICAL — prevents live keys loading in paper mode)
# ---------------------------------------------------------------------------
TRADING_MODE=paper
LIVE_TRADING_ENABLED=False
