# =============================================================================
# Paper Trading Simulator — .gitignore
# Security-first: block ALL secrets, keys, and env files from ever being committed
# =============================================================================

# ---------------------------------------------------------------------------
# SECRETS & ENVIRONMENT (CRITICAL — never remove these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account*.json
*.secret

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
*.whl
pip-wheel-metadata/
*.manifest
*.spec
.Python
develop-eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# Virtual environments
venv/
.venv/
ENV/
env/
.env/

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static_collected/

# ---------------------------------------------------------------------------
# Node / React (frontend)
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker/data/
mysql_data/
redis_data/

# ---------------------------------------------------------------------------
# IDE & OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------------
# Testing & Coverage
# ---------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# ---------------------------------------------------------------------------
# Celery
# ---------------------------------------------------------------------------
celerybeat-schedule
celerybeat.pid

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.bak
*.tmp
*.temp
*.orig
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# detect-secrets: the baseline IS tracked (CI diffs against it).
# It contains only hashes of already-vetted findings, never raw secrets.
# .secrets.baseline

# ML publisher drop directory (score artifacts are data, not code).
# Keep the directory with a marker; never commit downloaded scores.
ml_scores/*
!ml_scores/.gitkeep
